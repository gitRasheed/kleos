{
  "name": "agent-audio",
  "version": "0.2.0",
  "description": "Headless audio renderer and deterministic listening gate for coding agents.",
  "keywords": [
    "audio",
    "sfx",
    "synth",
    "loudness",
    "bs1770",
    "true-peak",
    "wav",
    "agents"
  ],
  "license": "MIT",
  "type": "module",
  "bin": {
    "agent-audio": "./dist/cli.js",
    "agent-daw": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "recipes",
    "skills",
    "LICENSE",
    "AGENTS.md",
    "STATE_MACHINES.md",
    "examples"
  ],
  "engines": {
    "node": ">=20.12.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepack": "npm run build",
    "typecheck": "tsc -p tsconfig.audio.json && tsc -p tsconfig.test.json --noEmit",
    "test": "tsc -p tsconfig.json && tsc -p tsconfig.test.json && node --test --test-concurrency=4 dist-test/tests/*.test.js dist-test/tests/standards/*.test.js tests/theory/*.test.mjs tests/studio/*.test.mjs",
    "lint": "eslint . --max-warnings=0",
    "check": "tsc -p tsconfig.audio.json && npm run lint && npm test"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^26.6.6",
    "eslint": "^9.39.5",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.74.0"
  },
  "exports": {
    ".": "./dist/index.js",
    "./compose": "./dist/compose.js",
    "./package.json": "./package.json"
  },
  "dependencies": {
    "@tonejs/midi": "2.0.28",
    "midi-file": "1.2.4",
    "musicxml-io": "0.14.0",
    "spessasynth_core": "4.4.12",
    "tonal": "6.10.0"
  },
  "repository": "https://github.com/gitRasheed/agent-audio.git"
}
