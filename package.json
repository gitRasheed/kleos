{
  "name": "kleos",
  "version": "0.2.0",
  "description": "Headless DAW, sheet-music engine and audio QA gate for AI coding agents. Render game audio, lint scores, exchange ABC, MusicXML and MIDI, and gate WAVs by LUFS and true peak in CI.",
  "keywords": [
    "kleos",
    "audio",
    "daw",
    "agent-audio",
    "agent-daw",
    "music-theory",
    "musicxml",
    "abc-notation",
    "midi",
    "sf2",
    "lufs",
    "ebu-r128",
    "mcp",
    "game-audio",
    "ci"
  ],
  "license": "MIT",
  "type": "module",
  "bin": {
    "kleos": "dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "recipes",
    "skills",
    "LICENSE",
    "AGENTS.md",
    "STATE_MACHINES.md",
    "examples/quickstart.daw.json"
  ],
  "engines": {
    "node": ">=20.12.0"
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist', {recursive:true, force:true})\" && tsc -p tsconfig.json",
    "prepack": "npm run build",
    "typecheck": "tsc -p tsconfig.audio.json && tsc -p tsconfig.test.json --noEmit",
    "test": "npm run build && node -e \"require('node:fs').rmSync('dist-test', {recursive:true, force:true})\" && tsc -p tsconfig.test.json && node --test --test-concurrency=4 dist-test/tests/*.test.js dist-test/tests/standards/*.test.js tests/theory/*.test.mjs tests/studio/*.test.mjs",
    "lint": "eslint . --max-warnings=0",
    "check": "tsc -p tsconfig.audio.json && npm run lint && npm test"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^26.6.6",
    "eslint": "^9.39.5",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.74.0",
    "@tonejs/midi": "2.0.28"
  },
  "exports": {
    ".": "./dist/index.js",
    "./compose": "./dist/compose.js",
    "./package.json": "./package.json"
  },
  "dependencies": {
    "midi-file": "1.2.4",
    "musicxml-io": "0.14.0",
    "spessasynth_core": "4.4.12",
    "@tonaljs/note": "4.12.7",
    "@tonaljs/chord": "6.5.0",
    "@tonaljs/key": "4.11.8",
    "@tonaljs/interval": "5.2.0",
    "@tonaljs/scale": "4.15.1"
  },
  "repository": "https://github.com/gitRasheed/kleos.git"
}
